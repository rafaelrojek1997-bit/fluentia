generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}
enum SystemRole {
  USER
  SUPPORT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  MAGIC_LINK
}
enum ConsentType {
  TERMS
  PRIVACY
  PERSONALIZATION
  ANALYTICS
  AI_PROCESSING
  AUDIO_RETENTION
  MODEL_IMPROVEMENT
  MARKETING
}
enum PrivacyRequestType {
  EXPORT
  DELETE_ACCOUNT
  DELETE_CONTENT
  RECTIFY
  RESTRICT_PROCESSING
}
enum RequestStatus {
  PENDING
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}
enum DataOrigin {
  USER_DECLARED
  OBSERVED
  AI_INFERRED
  SYSTEM_DERIVED
}
enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}
enum SkillType {
  SPEAKING
  LISTENING
  READING
  WRITING
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  FLUENCY
  INTERACTION
  FUNCTIONAL
}
enum MemoryType {
  FACT
  PREFERENCE
  INTEREST
  GOAL
  CONTEXT
  SUMMARY
}
enum MemoryStatus {
  CANDIDATE
  ACTIVE
  REJECTED
  EXPIRED
  DELETED
}
enum ScenarioStatus {
  DRAFT
  REVIEW
  ACTIVE
  ARCHIVED
}
enum SessionMode {
  TEXT
  VOICE
  MIXED
}
enum ConversationStatus {
  CREATED
  ACTIVE
  FINALIZING
  COMPLETED
  ABANDONED
  FAILED
  DELETED
}
enum ActorType {
  USER
  MENTOR
  SYSTEM
  TOOL
}
enum TurnStatus {
  RECEIVED
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
  MODERATED
}
enum AssessmentType {
  DIAGNOSTIC
  SESSION_FEEDBACK
  CONTROL_SAMPLE
  WRITING
  PRONUNCIATION
  REVIEW
}
enum AssessmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  LOW_CONFIDENCE
  FAILED
  INVALIDATED
}
enum ErrorCategory {
  GRAMMAR
  VOCABULARY
  WORD_ORDER
  AGREEMENT
  TENSE
  ARTICLE
  PREPOSITION
  PRONUNCIATION
  FLUENCY
  REGISTER
  NATURALNESS
  COMPREHENSION
  TASK_FULFILLMENT
  OTHER
}
enum MasteryState {
  NEW
  LEARNING
  REVIEWING
  STABLE
  LAPSED
}
enum LearningItemType {
  PHRASE
  COLLOCATION
  GRAMMAR_PATTERN
  PRONUNCIATION_PATTERN
  FUNCTIONAL_SKILL
  ERROR_PATTERN
}
enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}
enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  REPLACED
  CANCELLED
}
enum ActivityType {
  CONVERSATION
  REVIEW
  PRONUNCIATION
  DIAGNOSTIC
  GRAMMAR
  WRITING
  READING
  LISTENING
}
enum ActivityStatus {
  PLANNED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  SKIPPED
  REPLACED
  EXPIRED
}
enum SpeechAssetStatus {
  UPLOADING
  READY
  QUARANTINED
  PROCESSING
  PROCESSED
  DELETED
  FAILED
}
enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  REJECTED
}
enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  LOCAL
}
enum ModerationDecision {
  ALLOW
  BLOCK
  SAFE_COMPLETE
  REVIEW
}
enum ModerationStatus {
  OPEN
  TRIAGED
  ACTIONED
  DISMISSED
  ESCALATED
}
enum ReportReason {
  OFFENSIVE
  SEXUAL
  VIOLENCE
  HATE
  CHILD_SAFETY
  ILLEGAL
  SELF_HARM
  DECEPTIVE
  PRIVACY
  INCORRECT_FEEDBACK
  OTHER
}
enum SubscriptionProvider {
  STRIPE
  GOOGLE_PLAY
}
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  GRACE_PERIOD
  ON_HOLD
  PAUSED
  PAST_DUE
  CANCELLED
  EXPIRED
  REVOKED
}
enum EntitlementStatus {
  ACTIVE
  GRACE
  REVOKED
  EXPIRED
}
enum PurchasePlatform {
  WEB
  ANDROID
}
enum BillingEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}
enum UsageUnit {
  AI_INPUT_TOKEN
  AI_OUTPUT_TOKEN
  VOICE_SECOND
  STT_SECOND
  TTS_CHARACTER
  STORAGE_BYTE
  SESSION
}
enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}
enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}
enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}
enum JobStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}
model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String?      @db.VarChar(320)
  emailNormalized     String?      @unique @map("email_normalized") @db.VarChar(320)
  passwordHash        String?      @map("password_hash") @db.VarChar(255)
  status              UserStatus   @default(PENDING)
  locale              String       @default("pl-PL") @db.VarChar(35)
  timeZone            String       @default("Europe/Warsaw") @map("time_zone") @db.VarChar(64)
  emailVerifiedAt     DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  lastSignedInAt      DateTime?    @map("last_signed_in_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime?    @map("deletion_requested_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             Int          @default(1)
  identities          AuthIdentity[]
  sessions            AuthSession[]
  roles               UserRole[]
  tokens              OneTimeToken[]
  totp                 TotpCredential?
  recoveryCodes       RecoveryCode[]
  consents             ConsentRecord[]
  privacyRequests      PrivacyRequest[]
  profile              LearnerProfile?
  goals                LearnerGoal[]
  competencies         LearnerCompetency[]
  memories             LearnerMemory[]
  conversations        ConversationSession[]
  assessments          Assessment[]
  observations         LearnerObservation[]
  learningItems        LearningItem[]
  reviewAttempts       ReviewAttempt[]
  vocabularyEntries    VocabularyEntry[]
  plans                LearningPlan[]
  speechAssets         SpeechAsset[]
  aiRuns               AiRun[]
  subscriptions        Subscription[]
  entitlements         Entitlement[]
  usageEntries         UsageLedger[]
  moderationReports    ModerationReport[]
  notifications        Notification[]
  devices              UserDevice[]
  streak               UserStreak?
  xpEntries            XpLedger[]

  @@index([status, createdAt])
  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  emailAtProvider String? @map("email_at_provider") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.VarChar(255)
  tokenFamilyId        String    @map("token_family_id") @db.Uuid
  replacedBySessionId  String?   @map("replaced_by_session_id") @db.Uuid
  deviceName           String?   @map("device_name") @db.VarChar(120)
  userAgentHash        String?   @map("user_agent_hash") @db.VarChar(128)
  ipPrefixEncrypted    Bytes?    @map("ip_prefix_encrypted")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason         String?   @map("revoke_reason") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserRole {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      SystemRole
  grantedBy String?    @map("granted_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model OneTimeToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("one_time_tokens")
}

model TotpCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted Bytes     @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(3)
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_credentials")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model ConsentRecord {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          ConsentType
  policyVersion String      @map("policy_version") @db.VarChar(40)
  granted       Boolean
  source        String      @db.VarChar(32)
  jurisdiction  String?     @db.VarChar(8)
  recordedAt    DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(3)
  withdrawnAt   DateTime?   @map("withdrawn_at") @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt(sort: Desc)])
  @@map("consent_records")
}

model PrivacyRequest {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  type            PrivacyRequestType
  status          RequestStatus      @default(PENDING)
  verificationHash String?           @map("verification_hash") @db.VarChar(255)
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  exportObjectKey String?            @map("export_object_key") @db.VarChar(1024)
  failureCode     String?            @map("failure_code") @db.VarChar(80)
  manifest        Json?
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("privacy_requests")
}

model LearnerProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  nativeLanguage      String    @map("native_language") @db.VarChar(35)
  explanationLanguage String    @map("explanation_language") @db.VarChar(35)
  selfAssessedLevel   CefrLevel? @map("self_assessed_level")
  currentLevel        CefrLevel? @map("current_level")
  englishLevel        CefrLevel? @map("english_level")
  germanLevel         CefrLevel? @map("german_level")
  weeklyMinutes       Int       @default(75) @map("weekly_minutes")
  englishWeeklyMinutes Int       @default(75) @map("english_weekly_minutes")
  germanWeeklyMinutes  Int       @default(75) @map("german_weekly_minutes")
  correctionIntensity Int       @default(2) @map("correction_intensity") @db.SmallInt
  mentorStyle         String    @default("supportive") @map("mentor_style") @db.VarChar(32)
  interests           String[]  @default([])
  occupation          String?   @db.VarChar(160)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             Int       @default(1)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

model LearnerGoal {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(160)
  description String?   @db.Text
  targetDate  DateTime? @map("target_date") @db.Date
  priority    Int       @default(1) @db.SmallInt
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, priority])
  @@map("learner_goals")
}

model LearnerCompetency {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  skill           SkillType
  skillKey        String       @map("skill_key") @db.VarChar(120)
  level           CefrLevel?
  score           Decimal      @db.Decimal(6, 4)
  confidence      Decimal      @db.Decimal(5, 4)
  observationCount Int         @default(0) @map("observation_count")
  algorithmVersion String      @map("algorithm_version") @db.VarChar(40)
  lastObservedAt  DateTime?    @map("last_observed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int          @default(1)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill, skillKey])
  @@index([userId, score])
  @@map("learner_competencies")
}

model LearnerMemory {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           MemoryType
  status         MemoryStatus @default(CANDIDATE)
  key            String       @db.VarChar(120)
  valueEncrypted Bytes        @map("value_encrypted")
  origin         DataOrigin
  confidence     Decimal?     @db.Decimal(5, 4)
  sourceType     String?      @map("source_type") @db.VarChar(40)
  sourceId       String?      @map("source_id") @db.Uuid
  consentRecordId String?     @map("consent_record_id") @db.Uuid
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int          @default(1)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, type])
  @@index([expiresAt])
  @@map("learner_memories")
}

model Scenario {
  id                String         @id @default(uuid()) @db.Uuid
  slug              String         @db.VarChar(100)
  version           Int
  status            ScenarioStatus @default(DRAFT)
  title             Json
  description       Json
  supportedLevels   CefrLevel[]    @map("supported_levels")
  supportedModes    SessionMode[]  @map("supported_modes")
  learningObjectives Json          @map("learning_objectives")
  successRubric     Json           @map("success_rubric")
  configuration     Json
  publishedAt       DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversations     ConversationSession[]

  @@unique([slug, version])
  @@index([status, publishedAt])
  @@map("scenarios")
}

model ConversationSession {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  scenarioId         String             @map("scenario_id") @db.Uuid
  planActivityId     String?            @unique @map("plan_activity_id") @db.Uuid
  mode               SessionMode
  status             ConversationStatus @default(CREATED)
  targetLevel        CefrLevel           @map("target_level")
  mentorStyle        String              @map("mentor_style") @db.VarChar(32)
  correctionIntensity Int                @map("correction_intensity") @db.SmallInt
  policySnapshot     Json                @map("policy_snapshot")
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?           @map("ended_at") @db.Timestamptz(3)
  lastSequence       Int                 @default(0) @map("last_sequence")
  failureCode        String?             @map("failure_code") @db.VarChar(80)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            Int                 @default(1)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario           Scenario            @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  planActivity       PlanActivity?        @relation(fields: [planActivityId], references: [id], onDelete: SetNull)
  turns              ConversationTurn[]
  assessments        Assessment[]
  speechAssets       SpeechAsset[]
  moderationReports  ModerationReport[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("conversation_sessions")
}

model ConversationTurn {
  id               String       @id @default(uuid()) @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  sequence         Int
  actor            ActorType
  status           TurnStatus   @default(RECEIVED)
  contentEncrypted Bytes?       @map("content_encrypted")
  contentRedacted  String?      @map("content_redacted") @db.Text
  language         String?      @db.VarChar(35)
  parentTurnId     String?      @map("parent_turn_id") @db.Uuid
  aiRunId          String?      @unique @map("ai_run_id") @db.Uuid
  tokenCount       Int?         @map("token_count")
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  session          ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  aiRun            AiRun?       @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  observations     LearnerObservation[]
  reports          ModerationReport[]

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@map("conversation_turns")
}

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  sessionId       String?          @map("session_id") @db.Uuid
  type            AssessmentType
  status          AssessmentStatus @default(PENDING)
  rubricVersion   String           @map("rubric_version") @db.VarChar(40)
  result          Json?
  confidence      Decimal?         @db.Decimal(5, 4)
  aiRunId         String?          @map("ai_run_id") @db.Uuid
  invalidatedAt   DateTime?        @map("invalidated_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  aiRun           AiRun?           @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  observations    LearnerObservation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, type])
  @@map("assessments")
}

model LearnerObservation {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  assessmentId   String?       @map("assessment_id") @db.Uuid
  turnId         String?       @map("turn_id") @db.Uuid
  skill          SkillType
  skillKey       String        @map("skill_key") @db.VarChar(120)
  origin         DataOrigin
  value          Decimal       @db.Decimal(6, 4)
  weight         Decimal       @db.Decimal(5, 4)
  confidence     Decimal       @db.Decimal(5, 4)
  evidenceEncrypted Bytes?     @map("evidence_encrypted")
  errorCategory  ErrorCategory? @map("error_category")
  algorithmVersion String      @map("algorithm_version") @db.VarChar(40)
  observedAt     DateTime      @map("observed_at") @db.Timestamptz(3)
  invalidatedAt  DateTime?     @map("invalidated_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  turn           ConversationTurn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([userId, skill, skillKey, observedAt(sort: Desc)])
  @@index([assessmentId])
  @@map("learner_observations")
}

model LearningItem {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  type             LearningItemType
  language           String           @default("en") @db.VarChar(5)
